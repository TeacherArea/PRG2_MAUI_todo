<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PRG_MAUI_todo_app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PRG_MAUI_todo_app.View"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor= "#C2B280">

    <Shell.TitleView>
        <Label Text="Tabula"
               TextColor="White"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center" 
               Padding="8,8,0,0"/>
    </Shell.TitleView>

    <TabBar>
        <ShellContent Title="Lista" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </TabBar>
</Shell>
