<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_todo_app.View.ToDoDetailPage"
             Title="ToDoDetailPage"
             xmlns:debug="clr-namespace:PRG_MAUI_todo_app.Debugging;assembly=PRG_MAUI_todo_app"
             BackgroundImageSource="todo_background.jpg">
    
    <VerticalStackLayout>
        <Grid ColumnDefinitions="*,*"
                         RowDefinitions="Auto" >
            <Button Text="Till listan"
                    Clicked="Button_GoBack"
                    Margin="20,10,20,0"
                    Grid.Column="0"
                    HorizontalOptions="FillAndExpand"/>

            <Button Text="Spara"
                    Clicked="Button_SaveDesciption"
                    Margin="20,10,20,0"
                    Grid.Column="1"
                    HorizontalOptions="FillAndExpand"/>
        </Grid>

        <StackLayout Padding="20">
            <Label Text="{Binding Title}" 
               FontAttributes="Bold"
               FontSize="30"/>

            <Label Text="Beskrivning"
               FontAttributes="Bold"
               Margin="0,20,0,10"/>

            <Editor Text="{x:Reference EditorText}"
                x:Name="EditorText"
                BackgroundColor="White"
                HeightRequest="150"
                />
        </StackLayout>
    </VerticalStackLayout>

</ContentPage>